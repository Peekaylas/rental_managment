# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="Affordable Housing & Rental Management System"
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://rental_user:rental_pass@localhost:5432/rental_db

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# ─── First Admin Account (seeded on first run) ───────────────────────────────
FIRST_ADMIN_EMAIL=admin@rental.com
FIRST_ADMIN_PASSWORD=Admin@1234
